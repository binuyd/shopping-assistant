# Backend REST API endpoint URL
VITE_API_URL=http://localhost:5000/api

# Optional: Supabase Frontend Client Configuration (for auth & user cart sync)
# If omitted, cart persists locally via localStorage and product browsing/AI chat works normally
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
